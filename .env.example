# Optional RPC overrides. These are public endpoints only; this tool never needs a private key.
# Pattern: ATUM_VERIFY_RPC_<decimal chain id>=<url>
# ATUM_VERIFY_RPC_84532=https://base-sepolia-rpc.publicnode.com
# ATUM_VERIFY_RPC_421614=https://sepolia-rollup.arbitrum.io/rpc

# Optional per-chain eth_getLogs block-range override (blocks per request).
# Pattern: ATUM_VERIFY_LOG_RANGE_<decimal chain id>=<integer>
# ATUM_VERIFY_LOG_RANGE_84532=400
